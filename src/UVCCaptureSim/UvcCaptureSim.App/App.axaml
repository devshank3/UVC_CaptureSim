<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UvcCaptureSim.App.App"
             xmlns:local="using:UvcCaptureSim.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandBackground">#FF0B0E13</Color>
            <Color x:Key="BrandSurface">#FF141922</Color>
            <Color x:Key="BrandSurfaceAlt">#FF1B2230</Color>
            <Color x:Key="BrandBorder">#FF28303E</Color>
            <Color x:Key="BrandAccent">#FF22D3C5</Color>
            <Color x:Key="BrandAccentDim">#FF149C92</Color>
            <Color x:Key="BrandText">#FFE7ECF3</Color>
            <Color x:Key="BrandTextDim">#FF8A94A6</Color>
            <Color x:Key="BrandRec">#FFFF4D5E</Color>
            <Color x:Key="BrandAccentText">#FF05221F</Color>
            <Color x:Key="BrandPreview">#FF000000</Color>

            <SolidColorBrush x:Key="BrandBackgroundBrush" Color="{StaticResource BrandBackground}" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="{StaticResource BrandSurface}" />
            <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="{StaticResource BrandSurfaceAlt}" />
            <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorder}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}" />
            <SolidColorBrush x:Key="BrandAccentDimBrush" Color="{StaticResource BrandAccentDim}" />
            <SolidColorBrush x:Key="BrandTextBrush" Color="{StaticResource BrandText}" />
            <SolidColorBrush x:Key="BrandTextDimBrush" Color="{StaticResource BrandTextDim}" />
            <SolidColorBrush x:Key="BrandRecBrush" Color="{StaticResource BrandRec}" />
            <SolidColorBrush x:Key="BrandAccentTextBrush" Color="{StaticResource BrandAccentText}" />
            <SolidColorBrush x:Key="BrandPreviewBrush" Color="{StaticResource BrandPreview}" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
